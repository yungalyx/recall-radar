# Copy to .env and fill in. Everything here is optional except ASSEMBLYAI_API_KEY for voice.
# Never commit the filled-in copy -- .gitignore already excludes it.

# Voice (AssemblyAI streaming STT). Without it the app still works by typing; /stt-token returns 503.
# New accounts get free credit, no card: https://www.assemblyai.com/dashboard/home
ASSEMBLYAI_API_KEY=

# Public base URL, used in OAuth metadata and redirects. Set this to your real deploy URL.
PUBLIC_URL=

# HMAC secret for access tokens. Set in production or a restart invalidates every token.
JWT_SECRET=

PORT=8787
DB_PATH=recall-radar.db

# Seeded confidential OAuth client for the Alexa+ MCP add-on.
ALEXA_CLIENT_ID=alexa-plus
ALEXA_CLIENT_SECRET=dev-secret

# Optional: raises the openFDA rate limit. Free from https://open.fda.gov/apis/authentication/
FDA_API_KEY=

# Optional OpenAI-compatible reranker for match.js; heuristic scoring is the fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
